# ============================================================
# LLM DO AGENTE DE NAVEGACAO (agnostico, padrao OpenAI SDK)
# Funciona com: OpenRouter (padrao), OpenAI nativa, Ollama local,
# ou qualquer endpoint OpenAI-compatible (vLLM, Together, Groq...)
# Use um modelo RAPIDO com suporte a tool calling.
# ============================================================
AGENT_LLM_BASE_URL=https://openrouter.ai/api/v1
AGENT_LLM_API_KEY=sua-chave-aqui
AGENT_LLM_MODEL=deepseek/deepseek-v4-flash-0731
# Alternativas testadas:
# AGENT_LLM_MODEL=google/gemini-2.0-flash-001
# AGENT_LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# AGENT_LLM_MODEL=deepseek/deepseek-chat
# OpenAI nativa: AGENT_LLM_BASE_URL=https://api.openai.com/v1 + AGENT_LLM_MODEL=gpt-4o-mini
# Ollama local: AGENT_LLM_BASE_URL=http://localhost:11434/v1 + AGENT_LLM_MODEL=llama3.1 (+ qualquer API key)

# ============================================================
# REBASE JOBS (fonte complementar via MCP; opt-in)
# Gere um token pessoal após autenticar no Rebase Jobs.
# Outros servidores MCP remotos podem ser adicionados em MCP_SERVERS_JSON:
# [{"name":"meu-servidor","url":"https://...","token":"...","allowedTools":["tool_segura"]}]
MCP_SERVERS_JSON=[]
REBASE_JOBS_ENABLED=false
REBASE_JOBS_MCP_URL=https://rebasedev.com.br/mcp
REBASE_JOBS_TOKEN=
# Segurança: por padrão o modo apply NÃO envia para domínios externos vindos da fila.
# Ative explicitamente ou informe uma allowlist separada por vírgulas.
REBASE_JOBS_ALLOW_EXTERNAL_APPLY=false
REBASE_JOBS_ALLOWED_HOSTS=

# Modo de execução: full (padrão), discovery (só coleta fila), apply (processa fila)
OFFICEBOY_MODE=full

# Chave do Google Gemini (opcional — so como provider AUXILIAR/secundario
# e fallback automatico; o agente de navegacao usa AGENT_LLM_* acima)
GEMINI_API_KEY=

# ============================================================
# PORTAS (usadas pelo Docker/compose e pelo atalho ./bin/officeboy)
# Troque aqui se algo estiver ocupado na sua maquina.
# ============================================================
# Dashboard / control server (UI)
BOT_UI_PORT=1717
# Navegador remoto via noVNC (so no modo local)
BOT_NOVNC_PORT=7900
# Porta CDP do Chrome do host (so no modo host)
BOT_CDP_PORT=9222

# Endpoint CDP do Chrome (abra o Chrome com: google-chrome --remote-debugging-port=9222)
# Use 127.0.0.1 (IPv4), nao "localhost": o Chrome faz bind so em 127.0.0.1 e
# "localhost" pode resolver para ::1 (IPv6), dando "ECONNREFUSED ::1:9222".
CDP_ENDPOINT=http://127.0.0.1:9222

# Modelo Gemini (opcional — provider auxiliar/secundario e fallback;
# o agente de navegacao usa AGENT_LLM_MODEL acima)
GEMINI_MODEL=gemini-2.5-flash

# Limite de candidaturas por dia
LIMITE_DIARIO=10

# Teto de envios reais por execucao (protege a conta real de rajadas)
MAX_POR_EXECUCAO=5

# Teto de iteracoes do agente por run (cada iteracao = 1 chamada do LLM).
# Padrao 100; ajustavel tambem na UI, campo "interacoes", por run.
MAX_ITERACOES=500

# Delay entre acoes (ms)
DELAY_MIN=2000
DELAY_MAX=5000

# Modo Dry-Run (true = faz tudo menos submeter a candidatura de verdade)
DRY_RUN=false

# Score minimo para aplicar (1-10, quanto maior mais restritivo)
SCORE_MINIMO=6

# Meta de candidaturas de qualidade (score >= SCORE_MINIMO) por run. Ao atingir
# a meta, o run encerra com SUCESSO (resumo + recovery limpo). Texto do modelo
# NUNCA encerra o run — so a meta, o teto de iteracoes (MAX_ITERACOES) ou o
# custo maximo (CUSTO_MAX_USD). 0 = desativado.
META_CANDIDATURAS=10

# Custo maximo por execucao em USD (0 = desativado; interrompe o loop se exceder)
CUSTO_MAX_USD=0.30

# Pausar o run automaticamente ao detectar pagina de login (o processo fica
# vivo; a UI toca o som e o Telegram avisa — faca login no Chrome e clique
# Retomar). false = segue o fluxo sem pausar (comportamento antigo).
PAUSAR_EM_LOGIN=true

# Dashboard (porta do servidor web local)
DASHBOARD_PORT=3000
# Host de bind do dashboard (padrao: localhost; no Docker o compose define
# DASHBOARD_HOST=0.0.0.0 para o port-mapping 1717->3000 alcancar)
# DASHBOARD_HOST=127.0.0.1

# Token OPCIONAL de escrita da config (PUT /api/config/*). Definido, as rotas
# de escrita exigem o header X-Config-Token — protege contra outro
# dispositivo da rede trocando secrets/perfil. GET continua aberto.
# DASHBOARD_TOKEN=troque-por-um-segredo-longo

# Modo UI (control server): quando true, o processo sobe SÓ o dashboard com
# botoes de iniciar/parar — o agente NAO roda sozinho (nenhuma cota gasta ate
# voce pedir). false = o agente roda assim que o processo sobe.
# No Docker o compose define CONTROL_MODE=true (UI primeiro).
CONTROL_MODE=false

# Reinicio automatico ao salvar .env pela UI (somente com o bot PARADO):
# no Docker é detectado sozinho. Fora dele, defina true se houver um
# supervisor (systemd) que recrie o processo quando ele encerrar.
# OFFICEBOY_AUTO_RESTART=true

# ============================================================
# TELEGRAM (opcional — preencha para receber notificações)
# 1. Fale com @BotFather no Telegram e crie um bot
# 2. Copie o token do bot
# 3. Envie uma mensagem para o bot e acesse:
#    https://api.telegram.org/bot<SEU_TOKEN>/getUpdates
#    para obter seu chat_id
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ATIVO=true

# ============================================================
# EMAIL (opcional — preencha para receber relatório por email)
# Para Gmail: use uma "Senha de App" em vez da senha normal
# Gere em: https://myaccount.google.com/apppasswords
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_DESTINATARIO=
EMAIL_ATIVO=true

# ============================================================
# CRON (agendamento automático — desativado por padrão)
# Ative para o bot executar automaticamente no horário definido
# ============================================================
CRON_ATIVO=false
CRON_HORARIO=09:00

# ============================================================
# MULTI-LLM AUXILIAR (tarefas pesadas: cover letter, curriculo,
# mensagem recrutador. Pode ser um provedor TOTALMENTE diferente do agente.)
# Providers: openai (OpenRouter — padrao), ollama (local/grátis), gemini
# ============================================================
LLM_AUX_PROVIDER=openai
LLM_AUX_MODEL=deepseek/deepseek-chat

# Ollama (se LLM_AUX_PROVIDER=ollama)
# Instale: https://ollama.com — depois: ollama pull llama3
OLLAMA_URL=http://localhost:11434
# LLM_AUX_MODEL=llama3

# OpenAI-compatible (se LLM_AUX_PROVIDER=openai) — padrão via OpenRouter
# Funciona com: OpenRouter, OpenAI, Together AI, Groq, Mistral, vLLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LLM_AUX_MODEL=deepseek/deepseek-chat

# Gemini (se LLM_AUX_PROVIDER=gemini) — provider auxiliar/secundário
# (também é o fallback automático quando o provider principal falha)
# LLM_AUX_MODEL=gemini-2.5-flash
